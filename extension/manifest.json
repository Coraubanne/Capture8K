{
  "manifest_version": 3,
  "name": "Capture8K",
  "description": "Rerastérise la page visible en PNG natif 4K ou 8K sans déplacer sa mise en page, puis la certifie avec l’app macOS.",
  "version": "2.9.1",
  "minimum_chrome_version": "125",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": [
    "activeTab",
    "debugger",
    "nativeMessaging",
    "scripting",
    "storage",
    "tabs",
    "webNavigation"
  ],
  "host_permissions": [
    "<all_urls>"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "commands": {
    "capture-visible": {
      "suggested_key": {
        "default": "Ctrl+Shift+8",
        "mac": "Command+Shift+8"
      },
      "description": "Capturer immédiatement la page visible"
    }
  },
  "action": {
    "default_title": "Capture8K — Capturer la page visible en 4K / 8K",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon-16.png",
      "32": "icons/icon-32.png"
    }
  }
}
